# Retellis Web — Next.js PWA. Multi-stage: deps → build → runner.
FROM node:20-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/contracts/package.json ./packages/contracts/
RUN pnpm install --filter @ai-companion/web... --filter @ai-companion/contracts...

FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY --from=deps /app/ ./
COPY . .
# NEXT_PUBLIC_API_URL is intentionally unset so the client bundle uses
# same-origin relative URLs (/v1/...). Caddy routes /v1 → api and / → web on
# one origin, which is what makes the SameSite=Lax session cookie first-party.
# API_PROXY_TARGET bakes a server-side /v1 proxy into the build so the web
# container also works standalone on :3000 (browser → web, web proxies /v1 to
# the API on the docker network). Next.js evaluates `rewrites()` at BUILD time,
# so this must be set here, not at runtime. Harmless when Caddy is in front
# (Caddy routes /v1 itself and the web proxy is never hit).
ENV API_PROXY_TARGET=http://api:8000
RUN pnpm --filter @ai-companion/web build
# Precompress static build assets (gzip .gz siblings, originals kept) so Caddy
# can serve them with Content-Length via `file_server { precompressed gzip }` —
# avoiding the chunked stream that breaks over lossy client paths
# (ERR_INCOMPLETE_CHUNKED_ENCODING). BusyBox gzip has no -k, so write .gz
# explicitly. Already-compressed binaries (woff2/woff/png/jpg/etc.) are skipped.
RUN cd apps/web/.next/static && \
    find . -type f \( -name '*.js' -o -name '*.mjs' -o -name '*.css' \
      -o -name '*.svg' -o -name '*.json' -o -name '*.wasm' -o -name '*.txt' \) \
      -exec sh -c 'gzip -9c "$1" > "$1.gz"' _ {} \;

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Next.js standalone output: a self-contained server with only the needed deps.
# Built from the monorepo root, the standalone tree mirrors the workspace layout
# (server.js lands at apps/web/server.js), so we replicate that path here.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
# Entrypoint syncs the precompressed static into the shared next_static volume
# (Caddy serves it from there with Content-Length) before starting Next.js.
COPY deploy/web-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "apps/web/server.js"]