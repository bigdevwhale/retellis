# Retellis Web — Next.js PWA. Multi-stage: deps → build → runner.
FROM node:20-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/contracts/package.json ./packages/contracts/
RUN pnpm install --filter @ai-companion/web... --filter @ai-companion/contracts...

FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY --from=deps /app/ ./
COPY . .
# NEXT_PUBLIC_API_URL is intentionally unset so the client bundle uses
# same-origin relative URLs (/v1/...). Caddy routes /v1 → api and / → web on
# one origin, which is what makes the SameSite=Lax session cookie first-party.
# API_PROXY_TARGET bakes a server-side /v1 proxy into the build so the web
# container also works standalone on :3000 (browser → web, web proxies /v1 to
# the API on the docker network). Next.js evaluates `rewrites()` at BUILD time,
# so this must be set here, not at runtime. Harmless when Caddy is in front
# (Caddy routes /v1 itself and the web proxy is never hit).
ENV API_PROXY_TARGET=http://api:8000
RUN pnpm --filter @ai-companion/web build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Next.js standalone output: a self-contained server with only the needed deps.
# Built from the monorepo root, the standalone tree mirrors the workspace layout
# (server.js lands at apps/web/server.js), so we replicate that path here.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]