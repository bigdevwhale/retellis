# Stillside API — FastAPI + PyNaCl (libsodium) + the shared contracts package.
FROM python:3.12-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends libsodium23 libpq5 curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the shared contracts package first (cacheable). Copy pyproject + src/
# preserving the src/py layout the pyproject declares (where = ["src/py"]).
COPY packages/contracts/pyproject.toml ./packages/contracts/
COPY packages/contracts/src/ ./packages/contracts/src/
RUN pip install --no-cache-dir ./packages/contracts

# Install the API package (includes alembic + SQLAlchemy + pgvector deps).
COPY apps/api/pyproject.toml apps/api/alembic.ini ./apps/api/
COPY apps/api/src/ ./apps/api/src/
COPY apps/api/migrations/ ./apps/api/migrations/
RUN pip install --no-cache-dir ./apps/api

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --retries=10 --start-period=10s \
  CMD curl -fs http://localhost:8000/v1/health || exit 1

# Run Alembic migrations (best-effort: if the DB is unreachable the app still
# starts — `make_store` probes for the events table at startup and falls back
# to the in-memory store if the schema is missing, so `docker compose up` stays
# zero-config). Then launch uvicorn.
CMD ["sh", "-c", "cd /app/apps/api && (alembic upgrade head || echo '!!! ALEMBIC MIGRATIONS FAILED — see traceback above; app will start and the store will fall back to in-memory (schema missing)') && exec uvicorn ai_companion_api.main:app --host 0.0.0.0 --port 8000"]