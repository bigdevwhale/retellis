# Retellis reverse proxy — single origin for the web PWA + the FastAPI API.
#
# Why a proxy at all (and not two ports)? The verified session cookie is
# HttpOnly + Secure + SameSite=Lax. SameSite=Lax is only first-party when the
# browser sees web (/) and API (/v1) on ONE origin — which is what this Caddy
# gives us. It also closes the missing-TLS hole in the old deploy (credentials
# over HTTP) and makes CORS moot. The browser talks to Caddy only; web and api
# are not exposed to the host in the supported setup.
#
# CADDY_SITE controls the listen address:
#   - local / no domain: CADDY_SITE=:80  (HTTP — fine for localhost; the cookie
#     is marked Secure only when PUBLIC_ORIGIN is an https URL, so HTTP still
#     carries it on localhost).
#   - real domain:       CADDY_SITE=retellis.com  → Caddy auto-provisions
#     TLS via Let's Encrypt and redirects 80 → 443. Set PUBLIC_ORIGIN to the
#     https URL so cookies are marked Secure.

{
	admin off
}

{$CADDY_SITE} {
	# API surface (incl. the /v1/llm/stream SSE). flush_interval -1 disables
	# response buffering so streamed tokens reach the browser immediately; the
	# extended read/write timeouts keep long turns from being cut off.
	@api path /v1/*
	handle @api {
		encode zstd gzip
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Static build assets — served directly from the shared next_static volume
	# with precompressed gzip + Content-Length. Next.js standalone streams every
	# response chunked (no Content-Length); over lossy client paths the chunked
	# stream tears mid-transfer → ERR_INCOMPLETE_CHUNKED_ENCODING → ChunkLoadError
	# → blank page. Serving precompressed files from disk gives a known
	# Content-Length so there is nothing to tear. No `encode` here: precompressed
	# sets Content-Encoding: gzip itself, and on-the-fly encode would reintroduce
	# chunked for non-gzip/zstd clients.
	@static path /_next/static/*
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		header Vary Accept-Encoding
		root * /srv/static
		uri strip_prefix /_next/static
		file_server {
			precompressed gzip
		}
	}

	# Everything else → the Next.js PWA (standalone server on :3000).
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}