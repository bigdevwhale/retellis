# Retellis deployment environment.
# Copy to deploy/.env and fill in ONLY if you want the server-side fallback path.
# With everything empty, the backend uses a deterministic MOCK adapter and
# `docker compose up` works with zero configuration. BYOK keys (the primary
# path) are encrypted on the client and never touch this file.

# --- Server-side fallback LLM keys (all optional) ---
LITELLM_API_KEY_OPENAI=
LITELLM_API_KEY_ANTHROPIC=
LITELLM_API_KEY_OPENROUTER=
LITELLM_API_KEY_GOOGLE=
ANTHROPIC_API_KEY=

# --- Routing / budget ---
# Monthly USD cap across all providers. At 80% the dashboard warns; at 100%
# the real providers are skipped and the mock stand-in serves the turn.
MONTHLY_BUDGET_USD=20
# Ollama last-resort fallback (no key, base_url only). Leave empty to keep it
# on standby; set to a reachable Ollama endpoint to make it an active fallback.
# In compose, point this at an Ollama service or http://host.docker.internal:11434.
OLLAMA_BASE_URL=

# --- Messenger integration (Telegram) envelope key ---
# Persistent NaCl SecretBox key (base64) for at-rest envelope encryption of bot
# tokens AND BYOK provider keys (providers.api_key_ciphertext). When empty the
# API uses an EPHEMERAL key per process — every restart invalidates connected
# bots + stored BYOK keys, forcing a re-bind + re-add-key. Set once, keep stable
# + secret. Generate with:
#   python -c "from ai_companion_api.crypto.envelope import EnvelopeCipher; print(EnvelopeCipher.generate_key_b64())"
MESSENGER_TOKEN_DEK=

# --- Embeddings (optional semantic recall upgrade) ---
# hash (default) = deterministic feature-hashing embedder, zero-config, offline.
# semantic = batched litellm embeddings at recall time (falls back to hash on
# any failure, so recall never breaks). Requires EMBEDDINGS_API_KEY or
# LITELLM_API_KEY_OPENAI. The model must support 384-dim truncation
# (text-embedding-3-small / -3-large do).
EMBEDDINGS_MODE=hash
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=

# --- Langfuse (optional; leave empty to disable) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Browser-facing Langfuse URL for the routing dashboard link-out.
LANGFUSE_PUBLIC_URL=http://localhost:3001

# --- Auth & deployment mode ---
# Retellis runs in two modes from one codebase. The API validates the
# mode→backend matrix at boot and REFUSES to start on a forbidden combo, so a
# misconfiguration fails fast instead of silently degrading.
#
#   self_hosted + local profile  → AUTH_BACKEND=local ONLY (default; zero
#                                  external deps — no IdP, no SMTP)
#   self_hosted + sso profile    → AUTH_BACKEND=oidc | trusted_header
#                                  (magic_link only if SMTP configured)
#   hosted                       → AUTH_BACKEND=local | oidc | magic_link
#                                  (local = own email+password registration,
#                                  pair with FEATURE_EMAIL_VERIFICATION)
#
# Verified identity rides an HttpOnly + Secure + SameSite=Lax session cookie on
# ONE origin (Caddy in compose). The BYOK vault / ECDH / zeroize path is fully
# decoupled from identity and is not affected by these settings. The vault
# passphrase is NEVER sent to any auth endpoint — keep it distinct from the
# local-account login password below.

# self_hosted (default) | hosted
DEPLOYMENT_MODE=self_hosted
# local (default) | sso  — only meaningful when DEPLOYMENT_MODE=self_hosted
AUTH_SELF_HOSTED_PROFILE=local
# local (default) | oidc | magic_link | trusted_header
AUTH_BACKEND=local
# The single origin users hit. http://localhost for the local stack (cookies are
# marked Secure only for https URLs, so HTTP still carries them on localhost).
# For a real domain: PUBLIC_ORIGIN=https://retellis.com
PUBLIC_ORIGIN=http://localhost
AUTH_SESSION_COOKIE=retellis_sess
# NEVER enable in production. Dev/test escape hatch that trusts a self-asserted
# X-User-Id header; the test suite turns this on, real deployments must not.
AUTH_ALLOW_INSECURE_USER_HEADER=0

# --- Caddy reverse proxy (single origin + TLS) ---
# :80 for local (HTTP). Set a real domain (e.g. retellis.com) for Caddy to
# auto-provision Let's Encrypt TLS and redirect 80 → 443. When you set a domain,
# also set PUBLIC_ORIGIN to its https URL so cookies are marked Secure.
CADDY_SITE=:80
# Host ports Caddy binds. Override if 80/443 are taken on the host.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- OIDC / SSO (required when AUTH_BACKEND=oidc) ---
# Works for Google, GitHub (OAuth2), Keycloak, Authentik, Authelia, Dex, Okta,
# Microsoft Entra. AUTH_STATE_SECRET signs the PKCE state cookie — set a long
# random string; rotate by revoking sessions.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_DISPLAY_NAME=SSO
AUTH_STATE_SECRET=

# --- Magic link (required when AUTH_BACKEND=magic_link) ---
# AUTH_EMAIL_TRANSPORT=console prints the sign-in link to the API logs (dev
# only); =smtp sends via the SMTP settings below; =off disables (boot refuses
# this backend with transport off). AUTH_MAGIC_LINK_SECRET signs the tokens.
AUTH_MAGIC_LINK_SECRET=
AUTH_EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS policy for the SMTP transport: required (default — always upgrade,
# for external providers like Gmail/Mailgun/SES on 587), if_supported (upgrade
# only when the server advertises STARTTLS), or never (plain SMTP — for the
# internal postfix relay shipped in docker-compose.yml, which has no TLS cert).
# Port 465 is implicit TLS (SMTPS) and ignores this setting.
SMTP_STARTTLS=required

# --- Internal postfix relay (shipped in docker-compose.yml) ---
# The compose stack includes a send-only postfix + OpenDKIM service (port 25,
# internal to the compose network — NOT published to the host, so it is not an
# open relay). To route email through it, set:
#   SMTP_HOST=postfix
#   SMTP_PORT=25
#   SMTP_STARTTLS=never
#   SMTP_USER=        (empty — the relay trusts the compose network)
#   SMTP_PASSWORD=    (empty)
#   SMTP_FROM=noreply@retellis.com
# On first boot the postfix container generates a DKIM keypair and prints the
# public-key TXT record to its logs — add that record to DNS (see the DNS
# section below). Without DKIM + a warmed-up VPS IP, Gmail/Outlook will almost
# certainly spam-folder transactional mail; for reliable delivery use a
# transactional provider (SES/Resend/Postmark/Mailgun) with SMTP_* + the
# provider's DKIM/SPF records instead.

# --- Family invite signing key (HMAC-SHA256) ---
# Signs the one-time family-invite tokens (POST /v1/family/invites → email link
# → POST /v1/family/accept). Falls back to AUTH_STATE_SECRET when empty, and
# to an auto-generated persistent file under /var/lib/companion/invite_secret
# when both are unset — the local self_hosted+local profile relies on the
# auto-generated file. Set this explicitly to use a stable operator-chosen
# secret across hosts (e.g. a multi-replica deployment, or a restore-from-
# backup scenario where the volume is fresh but existing invite tokens are
# still in flight). 32+ bytes of high-entropy random recommended.
AUTH_INVITE_SECRET=

# --- Trusted-header / forward-auth (required when AUTH_BACKEND=trusted_header) ---
# For owners who run an identity-aware proxy (OAuth2 Proxy / Authelia / Traefik
# Forward Auth / nginx auth_request). The header is trusted ONLY behind an HMAC
# signature (AUTH_HEADER_HMAC_SECRET) AND, by default, an internal-network
# origin. Never expose the API directly when this backend is on — put Caddy (or
# your auth proxy) in front.
AUTH_TRUSTED_HEADER_NAME=X-Remote-User
AUTH_TRUSTED_HEADER_SIG_NAME=X-Remote-User-Sig
AUTH_HEADER_HMAC_SECRET=
AUTH_TRUSTED_REQUIRE_INTERNAL=1

# --- Hosted / billing (only when DEPLOYMENT_MODE=hosted) ---
# New hosted sign-ups start with this many USD of credits; the routing chain
# gates real providers when credits hit 0 (mock fallback, reason "out of
# credits"). Feature flags drive the web UI (show /plans, billing, magic links).
HOSTED_SIGNUP_CREDITS_USD=0
FEATURE_BILLING=0
FEATURE_CREDITS=0
FEATURE_HOSTED_FALLBACK=0
FEATURE_MAGIC_LINKS=0

# --- Email verification (local-account signup) ---
# Soft, opt-in ownership proof. When on, new local signups start
# email_verified=false and a verification link is emailed; the session is still
# issued immediately (soft — the user can use the app while unverified). Bootstrap
# REJECTS enabling this unless AUTH_BACKEND=local, AUTH_EMAIL_TRANSPORT=smtp, and
# a signing secret are all set. Default off → no behavior change. Existing rows
# are backfilled email_verified=true by migration 0025's column default.
FEATURE_EMAIL_VERIFICATION=0
# HMAC secret for verification tokens. Falls back to AUTH_MAGIC_LINK_SECRET
# when empty, so an operator who set one secret is covered. Never logged.
AUTH_EMAIL_VERIFICATION_SECRET=

# --- DNS for outbound email (retellis.com) ---
# For transactional mail (verification/magic-link) to actually reach the inbox
# rather than spam, these DNS records are required. Set them in the retellis.com
# zone (and the Selectel panel for PTR):
#   PTR  (reverse DNS): 135.106.193.10 → retellis.com  (set in the Selectel
#        panel; myhostname in deploy/postfix/main.cf must match this exactly)
#   SPF:  retellis.com.  TXT  "v=spf1 a -all"
#   DKIM: retellis._domainkey.retellis.com.  TXT  <printed by the postfix
#        container on first boot — `docker compose logs postfix`>
#   DMARC: _dmarc.retellis.com.  TXT  "v=DMARC1; p=quarantine; rua=mailto:postmaster@retellis.com"
# Honest caveat: a fresh VPS IP has no sender reputation. Even with all four
# records, Gmail/Outlook may still spam-folder mail until the IP warms up
# (gradual volume + engagement). For mission-critical delivery use a
# transactional provider instead of the self-hosted postfix.